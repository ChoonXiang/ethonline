# All scaffold commands work without an env file.
# Optional overrides go in .env.local (ignored by git).
RECOVERY_WORKER_HEARTBEAT_MS=30000
DEMO_HOST=127.0.0.1
DEMO_PORT=4001
CONTROL_API_TOKEN=
APPLICATION_ALLOWED_ORIGINS=
APPLICATION_DATABASE_PATH=var/applications.sqlite

# Partner credentials and network addresses are introduced with their adapters.
# Do not use NEXT_PUBLIC_ variables for backend credentials.
